{
  "name": "@local/dsh-remote-shell",
  "version": "1.2.0",
  "private": true,
  "description": "Run commands on configured remote servers over SSH — model tools plus a main-panel page to manage servers.",
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "ssh",
    "remote-shell"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xushl/dsh_plugin.git"
  },
  "homepage": "https://github.com/xushl/dsh_plugin#readme",
  "bugs": {
    "url": "https://github.com/xushl/dsh_plugin/issues"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
